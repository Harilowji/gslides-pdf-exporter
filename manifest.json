{
  "manifest_version": 3,
  "name": "Google Slides High-Res PDF Exporter",
  "version": "1.0.0",
  "description": "Automate capturing Google Slides presentation stages into a single high-resolution 16:9 PDF for offline study archiving.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://docs.google.com/presentation/d/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Google Slides PDF Exporter"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/presentation/d/*/edit*"
      ],
      "js": [
        "libs/jspdf.umd.min.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/jspdf.umd.min.js",
        "content.css",
        "icons/*"
      ],
      "matches": [
        "https://docs.google.com/presentation/d/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
